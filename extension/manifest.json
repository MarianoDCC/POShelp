{
  "manifest_version": 3,
  "name": "TuResto Impresión",
  "version": "2.1.0",
  "key": "",
  "description": "Conecta TuResto con el agente de impresión local (vinculado por código de 6 dígitos) para imprimir comandas y tickets sin diálogo de Windows.",
  "background": { "service_worker": "background.js" },
  "host_permissions": [
    "http://127.0.0.1:47823/*",
    "http://localhost:47823/*",
    "http://localhost/*",
    "https://turesto.pro/*",
    "https://*.turesto.pro/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://turesto.pro/*",
        "https://*.turesto.pro/*",
        "http://localhost/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
